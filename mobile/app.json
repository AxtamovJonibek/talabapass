{
  "expo": {
    "name": "TalabaPass",
    "slug": "talabapass",
    "scheme": "talabapass",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F1EE",
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "uz.talabapass.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "uz",
        "NSCameraUsageDescription": "Talaba guvohnomasini suratga olish, joy fotolarini olish va kassada QR kodni skanerlash uchun kamera kerak.",
        "NSPhotoLibraryUsageDescription": "Guvohnoma, hujjat va joy fotolarini galereyadan tanlash uchun ruxsat kerak.",
        "NSLocationWhenInUseUsageDescription": "Yaqin chegirmalarni ko'rsatish va masofani hisoblash uchun joylashuvingiz kerak. Joylashuv serverga ~100 m aniqlikda yuboriladi va saqlanmaydi."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "uz.talabapass.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2432D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#2432D6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Talaba guvohnomasini suratga olish, joy fotolarini olish va kassada QR kodni skanerlash uchun kamera kerak.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Guvohnoma, hujjat va joy fotolarini galereyadan tanlash uchun ruxsat kerak.",
          "cameraPermission": "Talaba guvohnomasini suratga olish, joy fotolarini olish va kassada QR kodni skanerlash uchun kamera kerak.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqin chegirmalarni ko'rsatish va masofani hisoblash uchun joylashuvingiz kerak. Joylashuv serverga ~100 m aniqlikda yuboriladi va saqlanmaydi.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_KEY"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2432D6"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.853458934258-u6d85ouqu2s078lh88g95ueme7tfm3jn"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "google": {
        "webClientId": "853458934258-hhttnplr9bpidjo7t6mqh89rv28ac798.apps.googleusercontent.com",
        "iosClientId": "853458934258-u6d85ouqu2s078lh88g95ueme7tfm3jn.apps.googleusercontent.com"
      }
    }
  }
}
