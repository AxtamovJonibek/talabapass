{
  "expo": {
    "name": "TalabaPass",
    "slug": "talabapass",
    "scheme": "talabapass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F1EE",
    "ios": {
      "bundleIdentifier": "uz.talabapass.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.talabapass.app",
      "adaptiveIcon": {
        "backgroundColor": "#2432D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F3F1EE"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Talaba guvohnomasini suratga olish va kassada QR kodni skanerlash uchun kamera kerak.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hujjat va joy fotolarini tanlash uchun galereyaga ruxsat kerak.",
          "cameraPermission": "Joy fotolarini suratga olish uchun kamera kerak.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqin chegirmalarni ko'rsatish va masofani hisoblash uchun joylashuvingiz kerak."
        }
      ],
      "react-native-maps",
      [
        "expo-notifications",
        {
          "color": "#2432D6"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ]
  }
}
