# Lokal: `npm run db:dev` chiqargan postgres:// manzilini qo'ying.
# Production: Neon pooled connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Faqat `prisma migrate dev` uchun (lokal). `npm run db:dev` shadow serverni ham ko'taradi.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Imzolar va xeshlar uchun sir (kamida 32 belgi). Yaratish: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
AUTH_SECRET=""
# SMS provayder. Bo`sh qoldirilsa lokalda "dev" (kod server log`iga chiqadi); production`da majburiy.
SMS_PROVIDER=""
# OTP_FIXED_CODE (har bir SMS kod bir xil bo`lishi) bu yerga YOZILMAYDI — faqat .env.development ga:
#   OTP_FIXED_CODE="000000"
# NODE_ENV=production bo`lganda OTP_FIXED_CODE yoki SMS_PROVIDER=dev topilsa server ishga tushmaydi.

# Faqat lokal `prisma dev` (PGlite) uchun: parallel ulanishlarda xato beradi, shuning uchun bitta ulanish.
# Production (Neon) da qo'ymang.
DATABASE_POOL_MAX="1"

# Vercel Cron: /api/cron/kuponlar faqat shu sir bilan (Authorization: Bearer ...). Production/staging da majburiy.
CRON_SECRET=

# Web Push (bildirishnomalar). Kalitlar: npm run push:keys. Uchalasi birga yoki hech biri; bo'lmasa faqat ilova ichidagi xabarlar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Rejalashtirilgan xabarlar: GitHub Actions (.github/workflows/cron.yml) har 5 daqiqada CRON_SECRET bilan chaqiradi.
