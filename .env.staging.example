# Sinov serveri (staging). Vercel'dagi Environment Variables shu ro'yxat bilan bir xil.
# Lokal nusxa: `.env.staging` (git'ga tushmaydi) — `npm run staging:seed` shuni o'qiydi.

APP_ENV="staging"
# Butun sayt Basic Auth: foydalanuvchi nomi ixtiyoriy, parol shu (kamida 12 belgi).
STAGING_PASSWORD=""

# Neon (alohida staging bazasi): Connection string → "Pooled connection" yoqilgan / o'chirilgan.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  (production'dagidan BOSHQA)
AUTH_SECRET=""

# Faqat staging'da ishlaydi (production'da server ishga tushmaydi).
OTP_FIXED_CODE="000000"
SMS_PROVIDER="dev"

# Private bucket (S3 API).
#   R2:       S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"   S3_REGION="auto"
#   Supabase: S3_ENDPOINT="https://<PROJECT_REF>.supabase.co/storage/v1/s3" S3_REGION="<loyiha regioni, masalan eu-central-1>"
STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="talabapass-staging"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
