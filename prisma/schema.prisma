generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Foydalanuvchi va kirish ─────────────

enum Role {
  STUDENT
  BUSINESS_OWNER
  CASHIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  /// Foydalanuvchi hisobini o'zi o'chirgan (`/api/v1/me` DELETE): shaxsiy ma'lumot tozalangan, raqam bo'shatilgan
  DELETED
}

model User {
  id                    String     @id @default(cuid())
  /// E.164: +998XXXXXXXXX. null — faqat Google/Apple bilan ochilgan hisob (ilova, `AuthIdentity`)
  phone                 String?    @unique
  /// Google/Apple tasdiqlagan email (faqat `email_verified`). Bir xil email — bitta hisob: yangi identifikator shu hisobga bog'lanadi
  email                 String?    @unique
  role                  Role
  firstName             String?
  lastName              String?
  locale                String     @default("uz")
  status                UserStatus @default(ACTIVE)
  blockedReason         String?
  /// Telegram orqali kirganlar uchun bot suhbati (xabarnomalar shu yerga ham). Telegram kirishi ulanganda to'ldiriladi.
  telegramChatId        String?
  /// Ilova paroli (scrypt, `src/server/auth/password.ts`). null — hali o'rnatilmagan: eski hisob SMS koddan keyin o'rnatadi.
  /// Sayt kirishi (SMS) parolni so'ramaydi.
  passwordHash          String?
  /// Ketma-ket noto'g'ri parollar (to'g'ri parol yoki bloklashda 0 ga qaytadi)
  passwordFails         Int        @default(0)
  passwordLockedUntil   DateTime?
  /// Parol birinchi marta o'rnatilgan vaqt
  passwordSetAt         DateTime?
  /// Parol oxirgi marta o'zgargan vaqt (o'rnatish, almashtirish, tiklash)
  passwordChangedAt     DateTime?
  /// Admin "parolni tiklash" bosgan: keyingi kirishda yangi parol majburiy (eski parol bilan kirish mumkin, lekin ichkariga o'tmaydi)
  passwordResetRequired Boolean    @default(false)
  /// Oxirgi muvaffaqiyatli kirish (har qanday usul)
  lastLoginAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  sessions           Session[]
  student            StudentProfile?
  ownedBusinesses    Business[]          @relation("BusinessOwner")
  memberships        BusinessMember[]
  coupons            Coupon[]
  redemptions        Redemption[]        @relation("RedemptionStudent")
  cashierSales       Redemption[]        @relation("RedemptionCashier")
  scanAttempts       ScanAttempt[]       @relation("ScanCashier")
  savedDiscounts     SavedDiscount[]
  notifications      UserNotification[]
  pushSubscriptions  PushSubscription[]
  pushDevices        PushDevice[]
  auditLogs          AuditLog[]
  universityRequests UniversityRequest[]
  orders             Order[]
  orderEvents        OrderEvent[]
  identities         AuthIdentity[]

  @@index([role, status])
}

enum AuthProvider {
  GOOGLE
  APPLE
}

/// Tashqi kirish (ilova: Google, Apple). `subject` — provayderdagi doimiy foydalanuvchi id (`sub`), email emas.
model AuthIdentity {
  id         String       @id @default(cuid())
  provider   AuthProvider
  subject    String
  /// Kirish paytidagi email (tasdiqlangan bo'lsa); faqat ko'rsatish uchun, bog'lash `User.email` orqali
  email      String?
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?

  @@unique([provider, subject])
  @@index([userId])
}

model OtpCode {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  /// 5 ta xato urinishdan keyin: kod bekor, raqam shu vaqtgacha bloklangan
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
}

/// "Parolni unutdim" — emailga yuborilgan 6 raqamli kod (10 daqiqa, 5 urinish). Bazada faqat HMAC.
model EmailCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// So'rovlar chegarasi uchun hisob (masalan, bitta IP'dan soatiga 10 ta SMS so'rovi).
/// key — "otp-ip:<IP ning HMAC xeshi>"; IP ochiq saqlanmaydi.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum SessionKind {
  /// Sayt: token httpOnly cookie'da
  WEB
  /// Mobil ilova API (`/api/v1`): token — aylanuvchi refresh token (xeshi boshqa prefiks bilan, cookie sifatida ishlamaydi)
  API
}

model Session {
  id            String      @id @default(cuid())
  userId        String
  kind          SessionKind @default(WEB)
  tokenHash     String      @unique
  /// API: oxirgi aylantirishdan oldingi refresh token xeshi — qayta ishlatilsa sessiya o'g'irlangan deb yopiladi
  prevTokenHash String?     @unique
  expiresAt     DateTime
  userAgent     String?
  /// API: ilova yuborgan qurilma nomi ("iPhone 15")
  deviceName    String?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevices PushDevice[]

  @@index([userId])
}

// ───────────── Talaba ─────────────

enum StudentStatus {
  /// ro'yxatdan o'tgan, guvohnoma hali yuklanmagan
  DRAFT
  PENDING
  APPROVED
  REJECTED
  /// cardExpiresAt o'tgan — yangi guvohnoma kerak
  EXPIRED
  BLOCKED
}

enum Course {
  C1
  C2
  C3
  C4
  MASTER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UniversityKind {
  /// davlat OTM
  STATE
  /// nodavlat (xususiy) OTM
  PRIVATE
  /// xorijiy OTM va uning filiallari
  FOREIGN
  /// "Ro'yxatda yo'q" — admin ko'rib chiqquncha talabalar shu yozuvga biriktiriladi (ro'yxatda ko'rinmaydi)
  OTHER
}

model University {
  id        String         @id @default(cuid())
  name      String         @unique
  /// TATU, O'zMU, TDIU ...
  shortName String
  city      String         @default("Toshkent")
  /// Viloyat (yoki "Toshkent shahri", "Qoraqalpog'iston Respublikasi")
  region    String         @default("Toshkent shahri")
  kind      UniversityKind @default(STATE)
  /// false — ro'yxatdan olib tashlangan (mavjud talabalar saqlanadi)
  active    Boolean        @default(true)
  /// Ma'lumot manbasi: "infoedu.uz, 2026-10-16" yoki "admin"; null — qo'lda/seed
  source    String?
  createdAt DateTime       @default(now())

  students StudentProfile[]
  requests UniversityRequest[]

  @@index([region])
}

enum UniversityRequestStatus {
  PENDING
  /// admin ro'yxatga qo'shdi yoki mavjud OTMga biriktirdi
  RESOLVED
  REJECTED
}

/// Talaba ro'yxatdan o'tishda "Ro'yxatda yo'q" tanlab yozgan OTM nomi — admin ko'rib chiqadi.
model UniversityRequest {
  id           String                  @id @default(cuid())
  userId       String
  name         String                  @db.VarChar(120)
  status       UniversityRequestStatus @default(PENDING)
  universityId String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

model StudentProfile {
  userId        String        @id
  universityId  String
  faculty       String?
  course        Course
  /// TP-2610-0418 — talaba kartasida ko'rinadi
  publicId      String        @unique
  status        StudentStatus @default(DRAFT)
  /// Guvohnoma raqami va muddatini admin tasdiqlash paytida kiritadi
  cardNumber    String?       @unique
  cardExpiresAt DateTime?     @db.Date
  notifyDeals   Boolean       @default(true)
  /// Ixtiyoriy: "Hudud" auditoriyasi (bildirishnomalar) shu maydondan olinadi
  districtId    String?
  /// Profil rasmi (kesilgan, tozalangan) - private bucket kaliti; yo'q bo'lsa bosh harflar ko'rsatiladi
  avatarKey     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  university    University     @relation(fields: [universityId], references: [id])
  district      District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  verifications Verification[]

  @@index([status])
  @@index([universityId])
  @@index([cardExpiresAt])
  @@index([districtId])
}

/// Har bir guvohnoma yuklash — alohida yozuv (tarix saqlanadi)
model Verification {
  id           String             @id @default(cuid())
  studentId    String
  /// private bucket kaliti — hech qachon public URL emas
  fileKey      String
  fileName     String
  fileSize     Int
  mime         String
  status       VerificationStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([studentId])
}

// ───────────── Biznes ─────────────

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  WARNED
  BLOCKED
}

enum BusinessKind {
  CAFE
  SHOP
  SERVICE
  SPORT
  BEAUTY
  EDUCATION
  ENTERTAINMENT
}

enum DocKind {
  REGISTRATION
  PHOTO
  OTHER
}

enum MemberRole {
  OWNER
  CASHIER
}

model District {
  id   String @id @default(cuid())
  name String @unique
  lat  Float
  lng  Float

  businesses Business[]
  students   StudentProfile[]
}

model Business {
  id           String         @id @default(cuid())
  ownerId      String
  name         String
  legalName    String?
  /// STIR (INN), 9 raqam
  tin          String?        @unique
  kind         BusinessKind
  /// "Choyxona", "Kinoteatr" — kartada ko'rinadigan qisqa tur
  typeLabel    String?
  districtId   String?
  address      String
  /// Qo'shimcha mo'ljal: "TATU yonida"
  landmark     String?
  lat          Float?
  lng          Float?
  workingHours String
  description  String?        @db.VarChar(120)
  logoKey      String?
  contactName  String?
  contactPhone String?
  /// Talabalarga ko'rinadigan aloqa (ixtiyoriy): telefon (E.164), Telegram va Instagram foydalanuvchi nomlari
  publicPhone  String?
  telegram     String?
  instagram    String?
  status       BusinessStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  /// Ariza (ma'lumot + hujjatlar) tekshiruvga yuborilgan payt. null — egasi hali hujjatlarni yuklamoqda,
  /// admin navbatida ko'rinmaydi. Rad etilgandan keyin qayta yuborilsa yangilanadi.
  submittedAt  DateTime?
  /// Chek raqami hisoblagichi — redeem tranzaksiyasida atom oshiriladi
  receiptSeq   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner        User                 @relation("BusinessOwner", fields: [ownerId], references: [id])
  district     District?            @relation(fields: [districtId], references: [id])
  docs         BusinessDoc[]
  members      BusinessMember[]
  invites      CashierInvite[]
  discounts    Discount[]
  redemptions  Redemption[]
  scanAttempts ScanAttempt[]
  preorder     PreorderSettings?
  permissions  BusinessPermissions?
  landing      LandingPartner?
  orders       Order[]

  @@index([status, submittedAt])
  @@index([ownerId])
}

model BusinessDoc {
  id         String   @id @default(cuid())
  businessId String
  kind       DocKind
  fileKey    String
  fileName   String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model CashierInvite {
  id           String    @id @default(cuid())
  businessId   String
  tokenHash    String    @unique
  phone        String?
  expiresAt    DateTime
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ───────────── Chegirma ─────────────

enum DiscountType {
  PERCENT
  FIXED_PRICE
  /// 1 + 1
  BOGO
}

enum StudentLimit {
  DAILY
  WEEKLY
  UNLIMITED
}

enum DiscountStatus {
  DRAFT
  /// admin tasdig'ini kutmoqda
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

model Category {
  id        String @id @default(cuid())
  /// taom, kofe, kitob, xizmat, sport, gozal, kino
  slug      String @unique
  name      String
  sort      Int    @default(0)
  tileColor String
  inkColor  String
  /// src/components/ui/icons dagi kalit
  icon      String

  discounts Discount[]
}

model Discount {
  id                String         @id @default(cuid())
  businessId        String
  categoryId        String
  title             String
  description       String?
  type              DiscountType
  /// so'm; "chekdan −15%" kabi narxsiz chegirmalarda null
  originalPrice     Int?
  percent           Int?
  newPrice          Int?
  /// Narx o'rniga ko'rinadigan matn: "Ikkinchi lavash bepul"
  note              String?
  /// Kategoriya ikonkasi/rangini almashtirish (ixtiyoriy)
  icon              String?
  tileColor         String?
  inkColor          String?
  /// 1 = dushanba … 7 = yakshanba (Toshkent vaqti)
  weekdays          Int[]
  /// Kun boshidan daqiqalar (Toshkent vaqti): 12:00 = 720. toMinute < fromMinute — oraliq yarim tundan o'tadi
  /// (22:00–02:00); haftaning kuni boshlanish vaqtiga qarab hisoblanadi.
  fromMinute        Int
  toMinute          Int
  dailyLimit        Int
  perStudentLimit   StudentLimit   @default(DAILY)
  startsOn          DateTime       @db.Date
  endsOn            DateTime       @db.Date
  terms             String?
  // ── Oldindan band qilish (biznes sozlamasi yoqilgan bo'lsa; tekshiruvsiz). Maydonlar `src/lib/preorder.ts` (`discountBookingInput`)
  bookingMode       BookingMode    @default(NONE)
  /// APPOINTMENT: xizmat davomiyligi, daqiqa — slot uzunligi
  serviceMinutes    Int            @default(30)
  /// APPOINTMENT: parallel sig'im (mutaxassis / ish joyi) — bir slotga shuncha buyurtma
  staffCount        Int            @default(1)
  /// PREPAID_PICKUP: to'lovdan keyin necha kun ichida olib ketiladi
  validDays         Int            @default(7)
  /// PREPAID_PICKUP: zaxira (dona) — buyurtmada atom kamayadi, bekor/muddati o'tganda qaytadi
  stock             Int            @default(0)
  /// PREPAID_PICKUP / PICKUP_WINDOW: bir talabaga jami (dona)
  perStudentMax     Int            @default(2)
  /// PREPAID_PICKUP: muddat o'tsa (yoki talaba bekor qilsa) biznesda qoladigan ulush, % (0 — to'liq qaytadi, 100 — qaytmaydi)
  expireKeepPercent Int            @default(0)
  /// PICKUP_WINDOW: kunlik olib ketish oynasi (Toshkent, daqiqa) va kunlik son (dona)
  windowFrom        Int            @default(840)
  windowTo          Int            @default(1200)
  windowCapacity    Int            @default(20)
  status            DiscountStatus @default(DRAFT)
  rejectReason      String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id])
  images      DiscountImage[]
  days        DiscountDay[]
  views       DiscountView[]
  savedBy     SavedDiscount[]
  coupons     Coupon[]
  redemptions Redemption[]
  orders      Order[]
  seats       BookingSeat[]

  @@index([status, endsOn])
  @@index([businessId])
  @@index([categoryId])
}

model DiscountImage {
  id         String @id @default(cuid())
  discountId String
  fileKey    String
  sort       Int    @default(0)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

/// Kunlik hisob. claimed = faol + sotilgan kuponlar; bekor/eskirganda atom kamayadi.
model DiscountDay {
  discountId String
  date       DateTime @db.Date
  claimed    Int      @default(0)
  redeemed   Int      @default(0)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, date])
}

model DiscountView {
  discountId String
  date       DateTime @db.Date
  count      Int      @default(0)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, date])
}

model SavedDiscount {
  studentId  String
  discountId String
  createdAt  DateTime @default(now())

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([studentId, discountId])
}

// ───────────── Kupon va sotuv ─────────────

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum PaymentType {
  CASH
  CARD
  QR
}

enum ScanResult {
  OK
  INVALID
  EXPIRED
  REPLAYED
  OUT_OF_HOURS
  LIMIT
  WRONG_BUSINESS
  BLOCKED
  MANUAL_LOCKED
}

/// Migratsiyada qo'shimcha: (studentId, discountId) bo'yicha status='ACTIVE' uchun qisman unique indeks.
model Coupon {
  id             String       @id @default(cuid())
  /// TP-7K3Q-92XD
  code           String       @unique
  discountId     String
  studentId      String
  /// Toshkent sanasi — DiscountDay bilan bog'lanadi
  date           DateTime     @db.Date
  status         CouponStatus @default(ACTIVE)
  /// TOTP siri — server kaliti bilan shifrlangan (AES-GCM)
  secret         Bytes
  manualAttempts Int          @default(0)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  closedAt       DateTime?

  // ── Olingan paytdagi shartlar (snapshot). Chegirma keyin tahrirlansa ham kupon shu shartlarda bajariladi.
  termsTitle          String
  termsType           DiscountType
  termsPercent        Int?
  /// so'm; narxsiz chegirmada (masalan "chekdan −15%") null — kassada kiritiladi
  termsOriginalPrice  Int?
  termsDiscountAmount Int?
  termsFinalPrice     Int?
  termsNote           String?

  discount     Discount      @relation(fields: [discountId], references: [id])
  student      User          @relation(fields: [studentId], references: [id])
  redemption   Redemption?
  scanAttempts ScanAttempt[]

  @@index([studentId, status])
  @@index([status, expiresAt])
  @@index([discountId, date])
}

model Redemption {
  id             String      @id @default(cuid())
  couponId       String      @unique
  receiptNo      Int
  businessId     String
  discountId     String
  studentId      String
  cashierId      String
  /// so'm; narxsiz chegirmalarda kassir kiritadi
  originalPrice  Int
  discountAmount Int
  paidAmount     Int
  paymentType    PaymentType
  createdAt      DateTime    @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  discount Discount @relation(fields: [discountId], references: [id])
  student  User     @relation("RedemptionStudent", fields: [studentId], references: [id])
  cashier  User     @relation("RedemptionCashier", fields: [cashierId], references: [id])

  @@unique([businessId, receiptNo])
  @@index([businessId, createdAt])
  @@index([studentId, createdAt])
  @@index([discountId, createdAt])
  @@index([createdAt])
}

model ScanAttempt {
  id         String     @id @default(cuid())
  businessId String
  cashierId  String
  couponId   String?
  result     ScanResult
  manual     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashier  User     @relation("ScanCashier", fields: [cashierId], references: [id])
  coupon   Coupon?  @relation(fields: [couponId], references: [id])

  @@index([businessId, createdAt])
  @@index([createdAt])
  @@index([cashierId, createdAt])
}

// ───────────── Bildirishnoma va audit ─────────────

enum Audience {
  ALL_STUDENTS
  UNIVERSITY
  DISTRICT
  BUSINESSES
  /// Bitta foydalanuvchiga tizim xabari (audienceIds = [userId]); admin tarixida ko'rinmaydi
  USER
}

enum NotificationStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum LinkType {
  HOME
  CATEGORY
  DISCOUNT
}

model Notification {
  id          String             @id @default(cuid())
  title       String             @db.VarChar(50)
  body        String             @db.VarChar(150)
  audience    Audience
  /// UNIVERSITY → universitet id'lari, DISTRICT → tuman id'lari
  audienceIds String[]
  linkType    LinkType           @default(HOME)
  linkId      String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      NotificationStatus @default(SCHEDULED)
  delivered   Int                @default(0)
  opened      Int                @default(0)
  createdById String
  createdAt   DateTime           @default(now())

  recipients UserNotification[]

  @@index([status, scheduledAt])
}

model UserNotification {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, createdAt])
  @@index([notificationId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PushPlatform {
  IOS
  ANDROID
}

/// Mobil ilova push tokeni (Expo/FCM/APNs). Sessiyaga bog'langan: chiqish yoki bloklashda sessiya bilan birga o'chadi.
model PushDevice {
  id        String       @id @default(cuid())
  userId    String
  sessionId String?
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tickets PushTicket[]

  @@index([userId])
  @@index([sessionId])
}

/// Expo push ticket'i: 15+ daqiqadan keyin kvitansiya so'raladi (`checkExpoReceipts`) — o'chirilgan ilova tokeni topiladi
model PushTicket {
  /// Expo ticket id
  id        String   @id
  deviceId  String
  createdAt DateTime @default(now())

  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────── Oldindan band qilish (buyurtma) va to'lov ─────────────

/// Chegirmani qanday band qilinadi: yo'q · vaqtli uchrashuv (slot) · to'lab, muddat ichida olib ketish · kunlik olib ketish oynasi
enum BookingMode {
  NONE
  APPOINTMENT
  PREPAID_PICKUP
  PICKUP_WINDOW
}

/// Eski (rejimlargacha) buyurtmalar uchun: olib ketish yoki joyida
enum OrderMode {
  PICKUP
  DINE_IN
}

enum PrepayType {
  FULL
  PARTIAL
  NONE
}

/// Holat o'tishlari faqat `src/lib/preorder.ts` dagi `ORDER_TRANSITIONS` bo'yicha (server `transitionOrder` orqali).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  READY
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
  /// PREPAID_PICKUP: muddat ichida olib ketilmadi
  EXPIRED
}

enum PaymentStatus {
  CREATED
  HELD
  CAPTURED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

/// Biznesning "Oldindan band qilish" sozlamasi. Yo'q yoki enabled=false — talabaga "Band qilish" ko'rinmaydi.
model PreorderSettings {
  businessId        String     @id
  enabled           Boolean    @default(false)
  /// Ish jadvali (vaqtli uchrashuv slotlari shu oraliqda), Toshkent vaqti, daqiqa: [{ "day": 1..7, "from": 840, "to": 1200 }]
  schedule          Json
  /// Slot boshlanishidan kamida shuncha daqiqa oldin band qilinadi (tayyorlash vaqti)
  leadMinutes       Int        @default(30)
  /// 0 — faqat bugun, 1 — bugun va ertaga
  daysAhead         Int        @default(1)
  prepay            PrepayType @default(FULL)
  /// PARTIAL da oldindan to'lanadigan ulush, %
  prepayPercent     Int        @default(50)
  /// Slotdan shuncha daqiqa oldingacha bekor qilish bepul (to'liq qaytariladi)
  freeCancelMinutes Int        @default(60)
  /// Kech bekor qilinsa yoki talaba kelmasa — oldindan to'lovning biznesda qoladigan ulushi, %
  keepPercent       Int        @default(100)
  autoConfirm       Boolean    @default(true)
  /// "Bugun qabul qilmayman": shu Toshkent sanasida yangi buyurtma olinmaydi
  pausedOn          DateTime?  @db.Date
  updatedAt         DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Sig'im hisoblagichi (chegirma × slot yoki kunlik oyna boshi): `INSERT … ON CONFLICT DO UPDATE … WHERE booked + n <= sig'im` bilan atom.
/// APPOINTMENT — buyurtma soni, PICKUP_WINDOW — dona.
model BookingSeat {
  discountId String
  startsAt   DateTime
  booked     Int      @default(0)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, startsAt])
}

model Order {
  id           String      @id @default(cuid())
  /// TB-7K3Q-92XD — kassada qo'lda kiritish uchun
  code         String      @unique
  businessId   String
  discountId   String
  studentId    String
  kind         BookingMode
  /// Faqat eski buyurtmalarda (rejimlargacha)
  mode         OrderMode?
  /// APPOINTMENT — slot; PICKUP_WINDOW — kunlik oyna; PREPAID_PICKUP — to'lov vaqti … muddat oxiri
  slotStart    DateTime
  slotEnd      DateTime
  quantity     Int
  note         String?     @db.VarChar(200)
  /// Aloqa uchun, E.164
  phone        String
  status       OrderStatus @default(PENDING_PAYMENT)
  /// QR (TOTP) siri — kupon kabi AES-GCM bilan shifrlangan
  secret       Bytes
  rejectReason String?

  // ── Snapshot: band qilingan paytdagi narx va qoidalar (keyin o'zgarsa ham shu buyurtmaga ta'sir qilmaydi)
  title             String
  unitOriginal      Int
  unitFinal         Int
  totalOriginal     Int
  totalFinal        Int
  prepay            PrepayType
  /// Oldindan to'lanadigan summa (NONE — 0)
  prepayAmount      Int
  freeCancelMinutes Int
  keepPercent       Int
  autoConfirm       Boolean

  /// Qo'lda tasdiqlashda javob muddati — o'tsa avtomatik bekor
  confirmBy DateTime?
  /// PREPAID_PICKUP: yuborilgan muddat eslatmalari (1 — "2 kun qoldi", 2 — "1 kun qoldi")
  reminders Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business     @relation(fields: [businessId], references: [id])
  discount Discount     @relation(fields: [discountId], references: [id])
  student  User         @relation(fields: [studentId], references: [id])
  payment  Payment?
  events   OrderEvent[]

  @@index([businessId, status, slotStart])
  @@index([studentId, createdAt])
  @@index([status, confirmBy])
  @@index([status, slotEnd])
  @@index([status, createdAt])
  @@index([kind, status, slotEnd])
}

/// Holat vaqt chizig'i (kim, qachon, qaysi holatdan qaysiga). actorId null — tizim (cron, to'lov).
model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  actorId   String?
  reason    String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  /// "mock" — hozircha; haqiqiy provayder keyin
  provider          String
  providerPaymentId String?
  amount            Int
  captured          Int           @default(0)
  refunded          Int           @default(0)
  status            PaymentStatus @default(CREATED)
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs  PaymentLog[]

  @@unique([provider, providerPaymentId])
}

/// Provayder so'rovlari va callback'larining xom yozuvi
model PaymentLog {
  id        String   @id @default(cuid())
  paymentId String
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

// ───────────── Super admin: biznes ruxsatlari va landing boshqaruvi ─────────────

/// Biznesga admin bergan ruxsatlar. Qator yo'q — hammasi standart (ruxsat bor, cheklovsiz). Panel va API ikkalasi
/// `src/server/business/permissions.ts` orqali tekshiradi.
model BusinessPermissions {
  businessId           String   @id
  canCreateDiscounts   Boolean  @default(true)
  /// Yuborilgan chegirma moderatsiyasiz darhol `ACTIVE` (mazmun o'zgarsa ham qayta tekshiruv yo'q)
  autoApproveDiscounts Boolean  @default(false)
  canPreorder          Boolean  @default(true)
  canAddCashiers       Boolean  @default(true)
  /// Bir vaqtda faol chegirmalar soni; null — cheklanmagan
  maxActiveDiscounts   Int?
  /// Nom, manzil, ish vaqti, tavsif, mo'ljal va logotip
  canEditProfile       Boolean  @default(true)
  /// Talabalar uchun aloqa: telefon, Telegram, Instagram
  canEditContacts      Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum LandingStatsMode {
  /// Bazadan (`landingStats`), `STATS_MIN` dan kichik bo'lsa bo'lim yashiriladi
  AUTO
  /// Admin kiritgan raqamlar (doim ko'rsatiladi)
  MANUAL
  /// Bo'lim yashirin
  HIDDEN
}

enum LandingDealsMode {
  /// Avtomatik: avval ochiqlari
  AUTO
  /// Faqat admin tanlaganlari (talabaga ko'rinadiganlari, tanlangan tartibda)
  MANUAL
  /// Avval tanlanganlar, qolgan joy avtomatik
  MIXED
}

/// Landing sozlamalari — bitta qator (`id = "landing"`).
model LandingSettings {
  id              String           @id @default("landing")
  statsMode       LandingStatsMode @default(AUTO)
  statsStudents   Int?
  statsBusinesses Int?
  statsDiscounts  Int?
  statsSaved      Int?
  dealsMode       LandingDealsMode @default(AUTO)
  /// MANUAL/MIXED: chegirma id'lari, ko'rsatish tartibida
  dealIds         String[]         @default([])
  updatedAt       DateTime         @updatedAt
}

/// "Hamkorlarimiz" bo'limidagi qator: tasdiqlangan biznes (`businessId`) yoki qo'lda qo'shilgan nom. Logotip — private
/// omborda (`landing/<uuid>.<ext>`), `/api/landing/hamkor/<id>` orqali hammaga (faqat ko'rinadiganlari).
model LandingPartner {
  id         String   @id @default(cuid())
  businessId String?  @unique
  name       String
  logoKey    String?
  sort       Int      @default(0)
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
