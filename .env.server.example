# Server (Airnet VPS, talabapass.uz) muhit o'zgaruvchilari — /etc/talabapass/env (chmod 600) shu ro'yxat bo'yicha.
# Faqat nomlar; qiymatlar repoga yozilmaydi. Format: KALIT=qiymat (export yo'q). Batafsil: docs/server.md.

NODE_ENV=production
# staging — sinov rejimi (SMS ulanguncha OTP_FIXED_CODE). Production'da qo'yilmaydi.
APP_ENV=
# true — ochiq sahifalar (landing, /ilova, huquqiy) indekslanadi; boshqa har qanday qiymat — butun sayt noindex + robots.txt
# "Disallow: /". Build vaqtida ham o'qiladi (o'zgartirilsa qayta deploy). Yoqish tartibi: docs/seo.md
SEO_INDEXABLE=false
AUTH_SECRET=
ADMIN_PASSWORD_HASH=

DATABASE_URL=

# local — STORAGE_LOCAL_DIR absolyut yo'l; s3 — S3_* majburiy.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMS_PROVIDER=
# Faqat APP_ENV=staging da.
OTP_FIXED_CODE=

# "Parolni unutdim" — emailga kod. resend (RESEND_API_KEY + EMAIL_FROM) yoki dev (faqat staging: xat log'ga chiqadi).
EMAIL_PROVIDER=
RESEND_API_KEY=
# Masalan: talabaPass <noreply@talabapass.uz> (domen Resend'da tasdiqlangan bo'lsin)
EMAIL_FROM=

CRON_SECRET=

# Uchalasi birga yoki hech biri.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Ixtiyoriy.
TELEGRAM_BOT_TOKEN=
SUPPORT_PHONE=
SUPPORT_TELEGRAM=

# Mobil ilova (GET /api/v1/app-config). Shu versiyadan past ilova — majburiy yangilash ekrani. Bo'sh — 1.0.0.
APP_MIN_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_LATEST_VERSION=
# Bo'sh: Android — Play sahifasi (uz.talabapass.app), iOS — yo'q (App Store ID ma'lum bo'lgach qo'ying).
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
# Expo push xavfsizligi yoqilgan bo'lsa (expo.dev → Access tokens). Ixtiyoriy.
EXPO_ACCESS_TOKEN=
# Ilova kirishi (GET /api/v1/app-config `auth`). false — "Telefon raqam bilan" tugmasi yashiriladi (SMS provayder joyi o'zgarmaydi).
AUTH_PHONE_ENABLED=true
# Google bilan kirish: ID token `aud` shu ro'yxatda bo'lsin. Client secret KERAK EMAS. Bo'sh — POST /auth/google 503.
# WEB — Android ilova tokeni ham shu bilan keladi; IOS — iOS client; ANDROID — Google Cloud'dagi Android client (SHA-1 bilan).
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# Apple bilan kirish: vergul bilan — iOS bundle ID va Android web oqimi uchun Services ID
# (masalan uz.talabapass.app,uz.talabapass.signin). Token `aud` i shu ro'yxat bo'yicha tekshiriladi. Bo'sh — POST /auth/apple 503;
# Services ID yo'q — Android'da "Apple orqali kirib bo'lmadi" (app-config auth.appleWeb=false). Return URL:
# https://talabapass.uz/api/v1/auth/apple/callback (Apple Developer → Services ID → Configure).
APPLE_CLIENT_ID=
# Do'kon tekshiruvchisi (Apple/Google review): FAQAT shu raqamga SMS o'rniga shu kod (production'da ham).
# Ikkalasi birga; chegaralar saqlanadi. Tekshiruv tugagach bo'shating. Raqam — tekshiruvchi uchun ochilgan sinov hisobi.
REVIEW_PHONE=
REVIEW_CODE=
