# Server (Airnet VPS, talabapass.uz) muhit o'zgaruvchilari — /etc/talabapass/env (chmod 600) shu ro'yxat bo'yicha.
# Faqat nomlar; qiymatlar repoga yozilmaydi. Format: KALIT=qiymat (export yo'q). Batafsil: docs/server.md.

NODE_ENV=production
# staging — sinov rejimi (noindex, SMS ulanguncha OTP_FIXED_CODE). Production'da qo'yilmaydi.
APP_ENV=
AUTH_SECRET=
ADMIN_PASSWORD_HASH=

DATABASE_URL=

# local — STORAGE_LOCAL_DIR absolyut yo'l; s3 — S3_* majburiy.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMS_PROVIDER=
# Faqat APP_ENV=staging da.
OTP_FIXED_CODE=

CRON_SECRET=

# Uchalasi birga yoki hech biri.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Ixtiyoriy.
TELEGRAM_BOT_TOKEN=
SUPPORT_PHONE=
SUPPORT_TELEGRAM=
